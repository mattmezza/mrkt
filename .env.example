MRKT_PUBLIC_URL=http://localhost:8080
MRKT_ENCRYPTION_KEY=base64:replace-with-32-random-bytes
MRKT_ADMIN_TOKEN=replace-with-at-least-32-random-characters-for-init
MRKT_FROM=mrkt <hello@example.com>
MRKT_TURNSTILE_SECRET=
MRKT_TURNSTILE_HOSTNAME=example.com
MRKT_TURNSTILE_ACTION=subscribe
MRKT_WEBHOOK_DEVELOPMENT_ALLOWED_HOSTS=
MRKT_INSTALLATION_ID=replace-with-stable-installation-id
MRKT_S3_BUCKET=mrkt
MRKT_S3_REGION=us-east-1
MRKT_S3_PREFIX=mrkt/production
MRKT_SMTP_HOST=smtp.example.com
MRKT_SMTP_PORT=587
MRKT_SMTP_TLS_MODE=starttls
MRKT_SMTP_USERNAME=
MRKT_SMTP_PASSWORD=
LITESTREAM_BUCKET=mrkt
LITESTREAM_PREFIX=mrkt/production/backups
LITESTREAM_REGION=us-east-1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
